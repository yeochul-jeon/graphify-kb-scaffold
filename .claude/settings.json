{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "Bash(git *)",
      "Bash(ALLOW_WIKI_EDIT=1 git commit*)",
      "Bash(python3 *)",
      "Bash(marp *)",
      "Bash(bash scripts/*)",
      "Bash(scripts/graphify-py.sh*)",
      "Bash(scripts/graphify-bootstrap.sh*)",
      "Bash(scripts/regen-graphify-skill.sh*)",
      "mcp__claude_ai_Notion__notion-fetch"
    ]
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": false,
    "jdtls-lsp@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ]
  }
}