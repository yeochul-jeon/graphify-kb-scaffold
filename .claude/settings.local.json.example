{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebSearch",
      "Bash(pipx --version)",
      "Bash(brew install:*)",
      "Bash(pipx ensurepath:*)",
      "Bash(export PATH=\"$HOME/.local/bin:$PATH\")",
      "Bash(pipx install:*)",
      "Bash(graphify:*)",
      "Bash(ls:*)",
      "Bash(awk:*)",
      "Bash(gh repo:*)",
      "Bash(du:*)",
      "Bash(/Users/YOUR_USER/.local/pipx/venvs/graphifyy/bin/python -c \"from graphify.watch import _rebuild_code; from pathlib import Path; _rebuild_code\\(Path\\('.'\\)\\)\")",
      "Bash(/Users/YOUR_USER/.local/pipx/venvs/graphifyy/bin/graphify build:*)",
      "Bash(/Users/YOUR_USER/.local/pipx/venvs/graphifyy/bin/graphify --help)",
      "Read(/Users/YOUR_USER/.claude/**)",
      "Read(/Users/YOUR_USER/.claude/skills/**)"
    ]
  }
}
