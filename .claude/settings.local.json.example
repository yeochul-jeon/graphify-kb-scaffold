{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebSearch",
      "Bash(pipx --version)",
      "Bash(brew install:*)",
      "Bash(pipx ensurepath:*)",
      "Bash(export PATH=\"$HOME/.local/bin:$PATH\")",
      "Bash(pipx install:*)",
      "Bash(graphify:*)",
      "Bash(ls:*)",
      "Bash(awk:*)",
      "Bash(gh repo:*)",
      "Bash(du:*)",
      "Read(/Users/YOUR_USER/.claude/**)",
      "Read(/Users/YOUR_USER/.claude/skills/**)"
    ]
  }
}
