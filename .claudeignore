# 생성된 출력물 — 항상 명시적 경로로 읽으므로 인덱싱 불필요
output/
.work-log/

# 바이너리/스크립트 — LLM이 읽을 필요 없음
*.py
*.html
*.png
*.jpg
*.jpeg
*.gif
*.pdf

# 첨부 파일 — 원천소스 보존용(raw/attachments 단일 위치). 명시적 요청 시에만 경로 지정해 읽기
raw/attachments/

# Web Clipper 캡처 인박스 (미처리 클립) — 무프롬프트 스캔만 막는다.
# 명시 경로 읽기는 통과하므로 `/ingest raw/Clippings/<파일>` 승격은 그대로 작동한다.
# 규정: .claude/rules/raw-ingest.md §Web Clipper 인박스
raw/Clippings/

# 민감 원본 자료 — 명시적 요청 없이는 Claude direct scan 대상 아님
raw/private/**
raw/company/**
raw/medical/**
raw/finance/**

# 그래프 파이프라인 아티팩트 — 대용량, 에이전트가 직접 읽을 필요 없음
# (요약은 graphify-out/GRAPH_DIGEST.md, 상세는 GRAPH_REPORT.md 참조)
graphify-out/*.json
graphify-out/cache/
wiki/graphify-out/

# 루트 작업 로그 — 명시적 요청 시에만 읽기
log.md
